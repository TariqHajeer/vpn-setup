#!/usr/bin/nft -f
# /etc/vpn/firewall.nft: the fixed part of the VPN firewall.
# Loaded at boot by vpn-firewall.service. `vpn apply` fills in the rest in
# /etc/vpn/generated/rules.nft (VPN interfaces, DNS servers, IP ranges of both lists
# and, while the kill switch is on, the kill-switch rules). See ~/vpn-setup/MANUAL.md.

# Start from an empty table on every load.
table inet vpnsplit
delete table inet vpnsplit

table inet vpnsplit {
    # Interfaces of the VPNs in /etc/vpn/vpns, plus "lo" so local proxies keep working.
    set vpn_ifaces { type ifname; }

    # DNS servers of the internet VPNs. Kill switch: never reach them outside a VPN.
    set vpn_dns_v4 { type ipv4_addr; }
    set vpn_dns_v6 { type ipv6_addr; }

    # IPs of the VPN-only domains. vpn-dns.service (dnsmasq) adds them as it answers.
    set vpnonly_v4 { type ipv4_addr; }
    set vpnonly_v6 { type ipv6_addr; }

    # IP ranges written directly in /etc/vpn/vpn-only.
    set vpnonly_ranges_v4 { type ipv4_addr; flags interval; auto-merge; }
    set vpnonly_ranges_v6 { type ipv6_addr; flags interval; auto-merge; }

    # Bypass list (/etc/vpn/bypass): destinations that always use the normal connection.
    # IPs of bypass domains (vpn-dns adds them as it answers) and ranges written in the list.
    set bypass_v4 { type ipv4_addr; }
    set bypass_v6 { type ipv6_addr; }
    set bypass_ranges_v4 { type ipv4_addr; flags interval; auto-merge; }
    set bypass_ranges_v6 { type ipv6_addr; flags interval; auto-merge; }
    # Public DNS servers that vpn-dns asks about bypass domains (asked directly, too).
    set bypass_dns_v4 { type ipv4_addr; }

    # Skipping the VPN. Packets get mark 0x6e76; the internet VPNs carry the ip rule
    # "priority 100 fwmark 0x6e76 table main", so marked packets take the normal route.
    chain mark_bypass {
        # A "route" chain makes the kernel pick the route again after the mark changes.
        type route hook output priority mangle; policy accept;
        # The kill switch wins: VPN-only destinations are never sent around the VPN.
        ip daddr @vpnonly_v4 return
        ip6 daddr @vpnonly_v6 return
        ip daddr @vpnonly_ranges_v4 return
        ip6 daddr @vpnonly_ranges_v6 return
        # Programs started with `novpn` (group "novpn"), e.g. games.
        meta skgid novpn counter meta mark set 0x6e76
        # Destinations on the bypass list.
        ip daddr @bypass_v4 counter meta mark set 0x6e76
        ip6 daddr @bypass_v6 counter meta mark set 0x6e76
        ip daddr @bypass_ranges_v4 counter meta mark set 0x6e76
        ip6 daddr @bypass_ranges_v6 counter meta mark set 0x6e76
        # vpn-dns's own lookups of bypass domains, so the answers fit your real location.
        meta skuid dnsmasq ip daddr @bypass_dns_v4 meta l4proto { tcp, udp } th dport 53 counter meta mark set 0x6e76
    }

    chain bypass_nat {
        # The app picked the VPN's source address before being rerouted;
        # swap it for the Wi-Fi address on the way out.
        type nat hook postrouting priority srcnat; policy accept;
        meta mark 0x6e76 oifname != "lo" counter masquerade
    }

    # Kill switch: `vpn apply` adds the rules while the kill switch is on.
    chain killswitch_out {
        type filter hook output priority filter; policy accept;
    }
    chain killswitch_fwd {
        type filter hook forward priority filter; policy accept;
    }
}

# Generated by `vpn apply`. A wildcard, so a missing file is fine.
include "/etc/vpn/generated/*.nft"
